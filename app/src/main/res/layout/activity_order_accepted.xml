<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#FFFFFF"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">


    <ImageView
        android:id="@+id/orderAcceptedImage"
        android:layout_width="270dp"
        android:layout_height="240dp"
        android:layout_marginTop="110dp"
        android:src="@drawable/order_done"
        android:scaleType="fitCenter"
        android:contentDescription="Order accepted"/>



    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Your Order has been&#10;accepted"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="#181725"/>



    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Your items has been placed and is on&#10;it's way to being processed"
        android:textSize="12sp"
        android:textColor="#7C7C7C"/>


    <Button
        android:id="@+id/trackOrderButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#53B175"
        android:layout_marginTop="150dp"
        android:text="Track Order"
        android:textColor="@android:color/white"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/backToHome"
        android:layout_width="wrap_content"
        android:layout_height="53dp"
        android:gravity="center"
        android:text="Back to home"
        android:textColor="#181725"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>