<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center"
        android:text="Favourite"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#181725"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E2E2"/>



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:src="@drawable/sprite"
                    android:scaleType="fitCenter"
                    android:contentDescription="Sprite Can"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sprite Can"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#181725"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="325ml, Price"
                        android:textSize="12sp"
                        android:textColor="#7C7C7C"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="$1.50"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#181725"/>

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:textColor="#181725"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E2E2"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:src="@drawable/diet_coke"
                    android:scaleType="fitCenter"
                    android:contentDescription="Diet Coke"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diet Coke"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#181725"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="355ml, Price"
                        android:textSize="12sp"
                        android:textColor="#7C7C7C"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="$1.99"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#181725"/>

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:textColor="#181725"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E2E2"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:src="@drawable/apple_juice"
                    android:scaleType="fitCenter"
                    android:contentDescription="Apple and Grape Juice"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apple &amp; Grape Juice"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#181725"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2L, Price"
                        android:textSize="12sp"
                        android:textColor="#7C7C7C"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="$15.50"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#181725"/>

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:textColor="#181725"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E2E2"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:src="@drawable/coca_cola"
                    android:scaleType="fitCenter"
                    android:contentDescription="Coca Cola Can"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coca Cola Can"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#181725"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="325ml, Price"
                        android:textSize="12sp"
                        android:textColor="#7C7C7C"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="$4.99"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#181725"/>

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:textColor="#181725"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E2E2"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="60dp"
                    android:src="@drawable/pepsi"
                    android:scaleType="fitCenter"
                    android:contentDescription="Pepsi Can"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pepsi Can"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#181725"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="330ml, Price"
                        android:textSize="12sp"
                        android:textColor="#7C7C7C"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="$4.99"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#181725"/>

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:textColor="#181725"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="105dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">



        <Button
            android:id="@+id/addAllToCart"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Add All To Cart"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="@android:color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#53B175"
            app:cornerRadius="16dp"/>

    </LinearLayout>



    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E2E2"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/white">



        <LinearLayout
            android:id="@+id/shopNavigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/shop"
                android:contentDescription="Shop"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop"
                android:textSize="10sp"
                android:textColor="#181725"
                android:layout_marginTop="3dp"/>

        </LinearLayout>



        <LinearLayout
            android:id="@+id/exploreNavigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/explore"
                android:contentDescription="Explore"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore"
                android:textSize="10sp"
                android:textColor="#181725"
                android:layout_marginTop="3dp"/>

        </LinearLayout>



        <LinearLayout
            android:id="@+id/cartNavigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/cart"
                android:contentDescription="Cart"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cart"
                android:textSize="10sp"
                android:textColor="#181725"
                android:layout_marginTop="3dp"/>

        </LinearLayout>



        <LinearLayout
            android:id="@+id/favouriteNavigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/fav"
                android:contentDescription="Favourite"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favourite"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#53B175"
                android:layout_marginTop="3dp"/>

        </LinearLayout>



        <LinearLayout
            android:id="@+id/accountNavigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/account"
                android:contentDescription="Account"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account"
                android:textSize="10sp"
                android:textColor="#181725"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>